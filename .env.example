PROJECT_NAME="FashionStore API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Base de datos PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REEMPLAZAR_CON_PASSWORD_LOCAL
POSTGRES_DB=fashionstore_db

# Seguridad JWT
SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_SEGURA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Decart Lucy 2.5 Realtime. El valor real de DECART_API_KEY se agrega solo en
# backend/.env al finalizar la implementación; nunca en Flutter ni en Git.
DECART_API_KEY=
DECART_API_BASE_URL=https://api.decart.ai
DECART_MODEL=lucy-2.5
DECART_ENABLED=false
DECART_TOKEN_TTL_SECONDS=60
DECART_SESSION_MAX_SECONDS=120
DECART_RATE_LIMIT_POR_MINUTO=10
# Allowlist de orígenes de imagen del probador (coma-separados). Permanece
# vacía hasta que el usuario configure los dominios permitidos; sin allowlist
# la autorización Decart falla de forma controlada sin afectar catálogo,
# carrito ni reservas.
DECART_ORIGENES_PERMITIDOS=

# Stripe Test Mode. Las claves reales las coloca el usuario en backend/.env
# al finalizar; nunca en Git. Sin claves la app inicia y Stripe responde 503.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# IA/Gemini (opcional). Sin GEMINI_API_KEY rige el fallback determinista.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=8
# Zona civil oficial para PostgreSQL y reglas de presentación. No cambiar a la
# zona del servidor; Bolivia usa America/La_Paz (UTC-4, sin horario de verano).
BUSINESS_TIMEZONE=America/La_Paz

# Push Flutter: usar una de las dos fuentes de credenciales.
# Local: ruta absoluta al JSON privado descargado de Firebase, fuera de Git.
GOOGLE_APPLICATION_CREDENTIALS=
# Render: contenido JSON completo como variable secreta del servicio.
FCM_SERVICE_ACCOUNT_JSON=
# Opcional si el JSON incluye project_id.
FCM_PROJECT_ID=

# Push web: pareja VAPID P-256. La privada debe ser PEM multilínea.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Activa expiración de reservas/ventas y despacho de outbox cada 30 segundos.
EXPIRACION_JOB_ACTIVO=false
EXPIRACION_JOB_MINUTOS=10
